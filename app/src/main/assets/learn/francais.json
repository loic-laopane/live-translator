{
  "id": "francais",
  "name": "Français",
  "language": "fr",
  "lessons": [
    {
      "id": "fr-homophones",
      "title": "Les homophones grammaticaux",
      "level": "a2",
      "summary": "a/à, ou/où, ces/ses/c'est/s'est : ne plus confondre.",
      "sections": [
        {
          "title": "a / à et ou / où",
          "body": "• « a » = verbe avoir (remplaçable par « avait ») ; « à » = préposition.\n• « ou » = choix (« ou bien ») ; « où » = lieu ou temps.",
          "examples": [
            {
              "text": "Il a faim.",
              "translation": "il a faim (verbe avoir)"
            },
            {
              "text": "Il va à Paris.",
              "translation": "il va à Paris (préposition)"
            },
            {
              "text": "Thé ou café ?",
              "translation": "choix"
            },
            {
              "text": "La ville où je suis né.",
              "translation": "lieu"
            }
          ]
        },
        {
          "title": "ces / ses / c'est / s'est",
          "body": "• ces : démonstratif pluriel (ces livres-là).\n• ses : possessif (les siens).\n• c'est = cela est.\n• s'est : se + être, devant un participe passé.",
          "examples": [
            {
              "text": "Il range ses livres.",
              "translation": "possessif"
            },
            {
              "text": "C'est facile.",
              "translation": "cela est facile"
            },
            {
              "text": "Il s'est trompé.",
              "translation": "pronominal"
            }
          ]
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "prompt": "Choisissez la bonne réponse :",
          "text": "Il ___ oublié son sac.",
          "options": [
            "a",
            "à"
          ],
          "answer": 0,
          "explanation": "On peut dire « il avait oublié » : verbe avoir."
        },
        {
          "type": "choice",
          "prompt": "Choisissez la bonne réponse :",
          "text": "Je ne sais pas ___ il habite.",
          "options": [
            "ou",
            "où"
          ],
          "answer": 1,
          "explanation": "Il s'agit d'un lieu : où."
        },
        {
          "type": "choice",
          "prompt": "Choisissez la bonne réponse :",
          "text": "Elle a perdu ___ clés. (les siennes)",
          "options": [
            "ces",
            "ses",
            "c'est"
          ],
          "answer": 1,
          "explanation": "Possessif : ses."
        },
        {
          "type": "choice",
          "prompt": "Choisissez la bonne réponse :",
          "text": "Il ___ blessé en tombant.",
          "options": [
            "c'est",
            "s'est",
            "ses"
          ],
          "answer": 1,
          "explanation": "Devant un participe passé : s'est."
        },
        {
          "type": "input",
          "prompt": "Complétez avec a ou à :",
          "text": "Elle habite ___ Lyon.",
          "answers": [
            "à"
          ],
          "explanation": "Préposition devant un lieu : à."
        }
      ]
    },
    {
      "id": "fr-participe",
      "title": "L'accord du participe passé",
      "level": "b1",
      "summary": "Avec être, avec avoir, et les pièges.",
      "sections": [
        {
          "title": "Avec « être » et avec « avoir »",
          "body": "• Avec être : accord avec le sujet.\n• Avec avoir : jamais d'accord avec le sujet ; accord avec le COD seulement s'il est placé AVANT le verbe.",
          "examples": [
            {
              "text": "Elles sont parties.",
              "translation": "accord avec le sujet"
            },
            {
              "text": "J'ai mangé les pommes.",
              "translation": "COD après : pas d'accord"
            },
            {
              "text": "Les pommes que j'ai mangées.",
              "translation": "COD « que » avant : accord"
            }
          ]
        },
        {
          "title": "Pièges",
          "body": "• Avec « en » : pas d'accord. • « fait » + infinitif : invariable.",
          "examples": [
            {
              "text": "Des pommes, j'en ai mangé.",
              "translation": "pas d'accord avec en"
            },
            {
              "text": "Elle s'est fait couper les cheveux.",
              "translation": "fait invariable"
            }
          ]
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "prompt": "Choisissez la bonne réponse :",
          "text": "Les fleurs que j'ai ___",
          "options": [
            "cueilli",
            "cueillies"
          ],
          "answer": 1,
          "explanation": "COD « que » placé avant : accord."
        },
        {
          "type": "choice",
          "prompt": "Choisissez la bonne réponse :",
          "text": "Elles ont ___ toute la nuit.",
          "options": [
            "dansé",
            "dansées"
          ],
          "answer": 0,
          "explanation": "Avec avoir et sans COD : invariable."
        },
        {
          "type": "choice",
          "prompt": "Choisissez la bonne réponse :",
          "text": "Ma sœur est ___ hier.",
          "options": [
            "arrivé",
            "arrivée"
          ],
          "answer": 1,
          "explanation": "Avec être : accord avec le sujet."
        },
        {
          "type": "input",
          "prompt": "Accordez :",
          "text": "Ces lettres, je les ai (écrit).",
          "answers": [
            "écrites"
          ],
          "explanation": "COD « les » placé avant : accord au féminin pluriel."
        }
      ]
    }
  ]
}
