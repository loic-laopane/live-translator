    {
      "id": "zh-tons",
      "title": "Les tons et le pinyin",
      "level": "a1",
      "summary": "Le mandarin a 4 tons + un ton neutre : ils changent le sens du mot.",
      "sections": [
        {
          "title": "Les quatre tons",
          "body": "Le pinyin note la prononciation avec l'alphabet latin ; l'accent indique le ton.\n• 1er ton (ā) : haut et plat.\n• 2e ton (á) : montant, comme une question en français.\n• 3e ton (ǎ) : descend puis remonte.\n• 4e ton (à) : descendant, sec.\n• Ton neutre (a) : court et léger.",
          "examples": [
            {
              "text": "妈",
              "translation": "mère (1er ton)",
              "pronunciation": "mā"
            },
            {
              "text": "麻",
              "translation": "chanvre (2e ton)",
              "pronunciation": "má"
            },
            {
              "text": "马",
              "translation": "cheval (3e ton)",
              "pronunciation": "mǎ"
            },
            {
              "text": "骂",
              "translation": "gronder (4e ton)",
              "pronunciation": "mà"
            },
            {
              "text": "吗",
              "translation": "particule interrogative (ton neutre)",
              "pronunciation": "ma"
            }
          ]
        },
        {
          "title": "Changements de ton",
          "body": "• Deux 3e tons qui se suivent : le premier se prononce au 2e ton (nǐ hǎo se dit ní hǎo).\n• 不 (bù, « ne… pas ») devient bú devant un 4e ton.",
          "examples": [
            {
              "text": "你好",
              "translation": "bonjour",
              "pronunciation": "nǐ hǎo"
            },
            {
              "text": "不是",
              "translation": "ne pas être",
              "pronunciation": "bú shì"
            }
          ]
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "prompt": "Quel ton est montant ?",
          "text": "",
          "options": [
            "1er ton",
            "2e ton",
            "3e ton",
            "4e ton"
          ],
          "answer": 1,
          "explanation": "Le 2e ton monte, comme une intonation de question.",
          "translateOptions": true
        },
        {
