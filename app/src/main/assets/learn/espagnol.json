    {
      "id": "es-ser-estar",
      "title": "Ser ou estar ?",
      "level": "a1",
      "summary": "Deux verbes pour dire « être ».",
      "sections": [
        {
          "title": "Ser : l'identité",
          "body": "On utilise « ser » pour ce qui définit : identité, nationalité, profession, caractère, matière, heure, date, et le lieu d'un événement.\nsoy, eres, es, somos, sois, son.",
          "examples": [
            {
              "text": "Soy francés.",
              "translation": "Je suis français."
            },
            {
              "text": "Ella es médica.",
              "translation": "Elle est médecin."
            },
            {
              "text": "Son las tres.",
              "translation": "Il est trois heures."
            },
            {
              "text": "La fiesta es en mi casa.",
              "translation": "La fête a lieu chez moi."
            }
          ]
        },
        {
          "title": "Estar : l'état et le lieu",
          "body": "On utilise « estar » pour un état passager, une émotion, la localisation (d'une personne ou d'un objet) et avec le gérondif.\nestoy, estás, está, estamos, estáis, están.",
          "examples": [
            {
              "text": "Estoy cansado.",
              "translation": "Je suis fatigué."
            },
            {
              "text": "Madrid está en España.",
              "translation": "Madrid est en Espagne."
            },
            {
              "text": "Está lloviendo.",
              "translation": "Il est en train de pleuvoir."
            }
          ]
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "prompt": "Choisissez la bonne réponse :",
          "text": "Yo ___ estudiante.",
          "options": [
            "soy",
            "estoy"
          ],
          "answer": 0,
          "explanation": "La profession / l'identité : ser."
        },
        {
          "type": "choice",
          "prompt": "Choisissez la bonne réponse :",
          "text": "Hoy ___ muy cansada.",
          "options": [
            "soy",
            "estoy"
          ],
          "answer": 1,
          "explanation": "État passager : estar."
        },
        {
          "type": "choice",
          "prompt": "Choisissez la bonne réponse :",
          "text": "¿Dónde ___ el baño?",
          "options": [
            "es",
            "está"
          ],
          "answer": 1,
          "explanation": "Localisation d'un objet : estar."
        },
        {
          "type": "choice",
          "prompt": "Choisissez la bonne réponse :",
