    {
      "id": "zh-classificateurs",
      "title": "Les classificateurs",
      "level": "a2",
      "summary": "Nombre + classificateur + nom : 一本书, 两只猫…",
      "sections": [
        {
          "title": "Le principe",
          "body": "En chinois, on ne peut pas mettre un nombre directement devant un nom : il faut un classificateur entre les deux.\nPour « deux » devant un classificateur, on utilise 两 (liǎng) et non 二 (èr).",
          "examples": [
            {
              "text": "一个人",
              "translation": "une personne",
              "pronunciation": "yí gè rén"
            },
            {
              "text": "两个朋友",
              "translation": "deux amis",
              "pronunciation": "liǎng gè péngyou"
            }
          ]
        },
        {
          "title": "Les plus courants",
          "body": "• 个 (gè) : le plus général, personnes et objets variés.\n• 本 (běn) : livres, cahiers.\n• 只 (zhī) : la plupart des animaux.\n• 杯 (bēi) : une tasse, un verre de…\n• 张 (zhāng) : objets plats (papier, table, billet).",
          "examples": [
            {
              "text": "一本书",
              "translation": "un livre",
              "pronunciation": "yì běn shū"
            },
            {
              "text": "三只猫",
              "translation": "trois chats",
              "pronunciation": "sān zhī māo"
            },
            {
              "text": "一杯茶",
              "translation": "une tasse de thé",
              "pronunciation": "yì bēi chá"
            },
            {
              "text": "一张纸",
              "translation": "une feuille de papier",
              "pronunciation": "yì zhāng zhǐ"
            }
          ]
        }
      ],
      "exercises": [
        {
          "type": "choice",
          "prompt": "Quel classificateur pour un livre (书) ?",
          "text": "一___书",
          "options": [
            "只",
            "本",
            "杯",
            "张"
          ],
          "answer": 1,
          "explanation": "本 (běn) s'emploie pour les livres."
        },
        {
          "type": "choice",
          "prompt": "Quel classificateur pour un chat (猫) ?",
          "text": "两___猫",
          "options": [
            "只",
            "本",
            "杯",
            "张"
          ],
          "answer": 0,
          "explanation": "只 (zhī) s'emploie pour les animaux."
        },
        {
          "type": "choice",
          "prompt": "« Deux personnes » se dit :",
          "text": "",
          "options": [
            "二个人",
            "两个人",
            "两人个"
          ],
          "answer": 1,
          "explanation": "On utilise 两 devant un classificateur."
        },
        {
          "type": "choice",
          "prompt": "Quel classificateur pour « une tasse de café » ?",
          "text": "一___咖啡",
          "options": [
            "个",
            "本",
            "杯",
            "只"
          ],
          "answer": 2,
          "explanation": "杯 (bēi) : une tasse / un verre de."
        },
        {
          "type": "input",
          "prompt": "Complétez avec le bon classificateur :",
          "text": "一___纸 (une feuille de papier)",
          "answers": [
            "张"
          ],
          "explanation": "张 (zhāng) pour les objets plats."
        }
      ]
    }
  ]
